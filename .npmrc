# ============================================
# pnpm 全局配置文件（pnpm 11.x 专用）
# 文档: https://pnpm.io/npmrc
# ============================================

# ------------------------------------------------------------
# 【构建脚本批准】 pnpm 9+ / 11+ 的安全机制
# ------------------------------------------------------------
# pnpm 9 开始默认禁止任何包运行 install/postinstall 等构建脚本，
# 会报 [ERR_PNPM_IGNORED_BUILDS] 错误。
#
# 解决办法（选一个即可，推荐按顺序优先级）：
#
# 方法 1（最推荐）：执行 pnpm approve-builds --all
#   它会把项目实际需要运行构建脚本的包清单自动写入 package.json
#   的 "pnpm.onlyBuiltDependencies" 字段中，最准确、不担心漏。
#
# 方法 2（本文件使用）：白名单通配符 *，允许所有包运行构建脚本
#   对于个人项目/内部项目这样完全没问题，
#   简单直接，不会漏包（之前列一个个包时 scoped 包还容易踩语法坑）。
onlyBuiltDependencies[]=*

# 这个配置配合上面的使用：允许执行 lifecycle scripts
ignore-scripts=false

# ------------------------------------------------------------
# 其他通用配置
# ------------------------------------------------------------
# 关闭对等依赖的严格检查，vue/ant-design 生态经常有 peer 版本对不齐的情况
strict-peer-dependencies=false
