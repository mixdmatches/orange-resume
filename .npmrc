# 禁止某些包的原生构建，避免在不同环境下编译失败
# 格式参考: https://pnpm.io/npmrc#onlybuiltdependencies
onlyBuiltDependencies-[]=@parcel/watcher
onlyBuiltDependencies-[]=core-js
onlyBuiltDependencies-[]=esbuild

# 使用国内镜像源，加速下载（可选，如果不需要可以注释掉）
registry=https://registry.npmmirror.com

# 提升依赖到 node_modules/.pnpm 扁平化存储，兼容老依赖
shamefully-hoist=true

# 严格对等依赖检查关闭，避免某些包 peer 依赖警告导致安装失败
strict-peer-dependencies=false
